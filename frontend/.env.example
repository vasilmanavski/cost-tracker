# Frontend environment variables
# Copy to .env.local and fill in values for local development
# For production, set these as build-time environment variables

# Google OAuth Client ID (optional — omit to disable Google sign-in)
# Get yours from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# API base URL (only needed for production — dev uses Vite proxy)
# VITE_API_URL=https://api.yourdomain.com
