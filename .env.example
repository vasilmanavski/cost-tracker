# ══════════════════════════════════════════════════════════════
# Cost Tracker — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in values.
#   Dev:  cp .env.example .env
#   Prod: cp .env.example .env.production
#
# Both docker-compose.yml and docker-compose.prod.yml read
# from .env (or the file specified with --env-file).
# ══════════════════════════════════════════════════════════════

# ── Database ──
POSTGRES_DB=cost_tracker
POSTGRES_USER=costtracker
POSTGRES_PASSWORD=changeme

# ── Backend ──
# Spring profile: "dev" for docker dev, "prod" for production
SPRING_PROFILES_ACTIVE=dev

# JDBC URL (must match POSTGRES_* values above)
# Dev:  jdbc:postgresql://postgres:5432/cost_tracker
# Prod: jdbc:postgresql://postgres:5432/cost_tracker
DB_URL=jdbc:postgresql://postgres:5432/cost_tracker
DB_USERNAME=costtracker
DB_PASSWORD=changeme

# JWT signing secret (min 256 bits / 32 chars)
# Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-real-secret-at-least-256-bits-long-for-hs256

# OpenAI API key for receipt OCR (optional — omit for mock mode)
# OPENAI_API_KEY=sk-...

# ── Google OAuth (optional — omit to disable Google sign-in) ──
GOOGLE_CLIENT_ID=

# ── Frontend (build-time) ──
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
